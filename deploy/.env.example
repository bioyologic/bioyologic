# Copia este archivo como .env y ajusta los valores.

# Dominio público del servidor (p. ej. un subdominio gratuito de DuckDNS).
BIOYOLOGIC_DOMAIN=bioyologic.duckdns.org

# Repositorio público del código (obligatorio por la AGPL-3.0, sección 13).
BIOYOLOGIC_SOURCE_URL=https://github.com/bioyologic/bioyologic

# Contacto del responsable del tratamiento de datos personales (Ley 1581 de 2012).
BIOYOLOGIC_CONTACT_EMAIL=martinezc.juanjo@gmail.com

BIOYOLOGIC_MAX_UPLOAD_MB=15
BIOYOLOGIC_RATE_LIMIT=20
BIOYOLOGIC_CONF=0.25

# Envío de correos (verificación de cuentas nuevas y "¿Olvidaste tu contraseña?").
# Sin BIOYOLOGIC_SMTP_HOST no se envían correos: las cuentas no piden verificación y la
# recuperación de contraseña remite al correo de contacto. Con Gmail se usa una
# "contraseña de aplicación" (myaccount.google.com/apppasswords), no la contraseña normal.
# BIOYOLOGIC_SMTP_HOST=smtp.gmail.com
# BIOYOLOGIC_SMTP_PORT=587
# BIOYOLOGIC_SMTP_USER=tu_cuenta@gmail.com
# BIOYOLOGIC_SMTP_PASSWORD=contraseña_de_aplicacion_de_16_letras
# BIOYOLOGIC_MAIL_FROM=Bioyologic <tu_cuenta@gmail.com>
