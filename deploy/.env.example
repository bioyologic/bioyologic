# Copia este archivo como .env y ajusta los valores.

# Dominio público del servidor (p. ej. un subdominio gratuito de DuckDNS).
BIOYOLOGIC_DOMAIN=bioyologic.duckdns.org

# Repositorio público del código (obligatorio por la AGPL-3.0, sección 13).
BIOYOLOGIC_SOURCE_URL=https://github.com/Godjuanjo/bioyologic

BIOYOLOGIC_MAX_UPLOAD_MB=15
BIOYOLOGIC_RATE_LIMIT=20
BIOYOLOGIC_CONF=0.25
